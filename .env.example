# =============================================================================
# speech-lab — copie para .env e ajuste. O .env NÃO é versionado.
# =============================================================================

# --- geral -------------------------------------------------------------------
SPEECHLAB_DB_PATH=data/speechlab.db
SPEECHLAB_AUDIO_DIR=data/audio
SPEECHLAB_LOG_LEVEL=INFO

# --- device ------------------------------------------------------------------
# auto = cuda -> mps -> cpu. Force "cpu" se quiser números bit a bit reprodutíveis.
SPEECHLAB_DEVICE=auto
# O forced_align do torchaudio não tem kernel MPS e o GOP precisa ser
# determinístico: estes dois estágios rodam em CPU independentemente do acima.
SPEECHLAB_FORCE_CPU_FOR_ALIGNMENT=true

# Quantas engines LOCAIS (pesadas) rodam ao mesmo tempo. Em 16 GB, 2 é o teto
# seguro: cada wav2vec2-large ocupa ~1.2 GB e o whisper large-v3 int8 ~1.5 GB.
# Engines remotas (azure, gemini) não contam neste limite — são I/O.
SPEECHLAB_MAX_LOCAL_CONCURRENCY=2
SPEECHLAB_ENGINE_TIMEOUT_S=300

# Quantos modelos ficam residentes em memória antes do LRU descarregar o mais antigo.
SPEECHLAB_MODEL_CACHE_SIZE=2

# --- privacidade (LGPD) ------------------------------------------------------
# true = após extrair features e rodar as engines, o WAV é apagado; ficam só
# sha256, vetores e métricas. ATENÇÃO: quebra o player sincronizado e impede
# re-execução da amostra.
SPEECHLAB_DISCARD_AUDIO_AFTER_FEATURES=false

# --- engines habilitadas -----------------------------------------------------
# Engines que enviam áudio para fora exigem opt-in explícito aqui.
SPEECHLAB_ENABLE_WHISPER_BASELINE=true
SPEECHLAB_ENABLE_WHISPER_STRICT=true
SPEECHLAB_ENABLE_CTC_GREEDY=true
SPEECHLAB_ENABLE_PHONEME_GOP=false
SPEECHLAB_ENABLE_AZURE_PA=false
SPEECHLAB_ENABLE_GEMINI_AUDIO=false

# --- whisper_baseline --------------------------------------------------------
SPEECHLAB_WHISPER_MODEL=large-v3
# CTranslate2 não tem backend Metal: em Apple Silicon isto é sempre CPU.
SPEECHLAB_WHISPER_COMPUTE_TYPE=int8

# --- ctc_greedy --------------------------------------------------------------
SPEECHLAB_CTC_MODEL=Edresson/wav2vec2-large-xlsr-coraa-portuguese
# alternativa: lgris/bp400-xlsr

# --- phoneme_gop -------------------------------------------------------------
SPEECHLAB_PHONEME_MODEL=facebook/wav2vec2-lv-60-espeak-cv-ft
SPEECHLAB_GOP_THRESHOLD=-2.0
SPEECHLAB_METATHESIS_WINDOW=3
# macOS arm64: o phonemizer não localiza a lib do espeak sozinho.
PHONEMIZER_ESPEAK_LIBRARY=/opt/homebrew/lib/libespeak-ng.dylib

# --- azure_pa (envia áudio para fora) ----------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
# tarifa só para estimativa de custo — preço muda, não fica em código
SPEECHLAB_AZURE_USD_PER_HOUR=1.00

# --- gemini_audio (envia áudio para fora) ------------------------------------
GEMINI_API_KEY=
SPEECHLAB_GEMINI_MODEL=gemini-2.5-flash
SPEECHLAB_GEMINI_USD_PER_1K_INPUT=0.0
SPEECHLAB_GEMINI_USD_PER_1K_OUTPUT=0.0
